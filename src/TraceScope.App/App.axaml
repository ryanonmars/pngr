<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TraceScope.App.App" Name="TraceScope" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme><FluentTheme.Palettes><ColorPaletteResources x:Key="Dark" Accent="#637664"/></FluentTheme.Palettes></FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="Window"><Setter Property="FontFamily" Value="Segoe UI, Helvetica Neue, sans-serif"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#D5D8DE"/><Setter Property="Background" Value="#191A1D"/></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="2"/><Setter Property="Padding" Value="7,2"/><Setter Property="MinHeight" Value="23"/><Setter Property="FontSize" Value="10"/><Setter Property="Background" Value="#30333A"/><Setter Property="BorderBrush" Value="#444850"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#334D3B"/><Setter Property="Foreground" Value="#B4DFBB"/></Style>
    <Style Selector="Button.close-target"><Setter Property="MinHeight" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="MinWidth" Value="18"/><Setter Property="Width" Value="18"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="2"/><Setter Property="MinHeight" Value="24"/><Setter Property="Padding" Value="5,2"/><Setter Property="Background" Value="#23252A"/><Setter Property="BorderBrush" Value="#494D55"/></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="23"/><Setter Property="Padding" Value="5,1"/><Setter Property="FontSize" Value="10"/></Style>
    <Style Selector="NumericUpDown"><Setter Property="MinHeight" Value="24"/><Setter Property="FontSize" Value="10"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="9,3"/><Setter Property="MinHeight" Value="26"/></Style>
    <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="#3B3F48"/></Style>
    <Style Selector="DataGrid"><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeight" Value="22"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#CFD2D8"/></Style>
    <Style Selector="DataGridCell"><Setter Property="Padding" Value="4,0"/><Setter Property="FontSize" Value="11"/></Style>
    <Style Selector="DataGridRow:selected"><Setter Property="Background" Value="#3B4149"/></Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="#A8ADB7"/>
      <Setter Property="Template"><ControlTemplate><Border Background="#25272D" BorderBrush="#3B3E45" BorderThickness="0,0,0,1" Padding="4,0"><ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border></ControlTemplate></Setter>
    </Style>
  </Application.Styles>
</Application>
