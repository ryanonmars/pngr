<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:TraceScope.App.Controls" xmlns:views="clr-namespace:TraceScope.App.Views" x:Class="TraceScope.App.MainWindow" Title="Pngr — Network diagnostics" Icon="avares://pngr/Assets/Icons/pngr.png" Width="1200" Height="800" MinWidth="980" MinHeight="640" Background="#191A1D">
  <Window.Styles>
    <Style Selector="Button.update-indicator"><Setter Property="MinHeight" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="Padding" Value="4,0"/><Setter Property="FontSize" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#9CC7A5"/></Style>
    <Style Selector="Button.update-indicator:pointerover"><Setter Property="Background" Value="#2C3330"/><Setter Property="Foreground" Value="#B4DFBB"/></Style>
    <Style Selector="Button.update-indicator:focus-visible"><Setter Property="BorderBrush" Value="#9CC7A5"/></Style>
  </Window.Styles>
  <DockPanel>
    <NativeMenuBar x:Name="ApplicationMenuBar" DockPanel.Dock="Top" IsVisible="False"/>
  <Grid RowDefinitions="28,36,38,*,24" Background="#191A1D">
    <Border Background="#23252A" BorderBrush="#36383E" BorderThickness="0,0,0,1" Padding="7,0">
      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
        <Image x:Name="BrandWordmark" Source="{StaticResource PngrWordmark}" Width="50" Height="18" Stretch="Uniform" VerticalAlignment="Center" AutomationProperties.Name="Pngr"/>
        <TextBlock Grid.Column="1" x:Name="TargetTitle" Text="Ready to trace" FontSize="11" Foreground="#DBDDE1" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" x:Name="TargetSubtitle" IsVisible="False" Text="" FontSize="10" Foreground="#999DA6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="#1D1F23" BorderBrush="#36383E" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="5">
        <StackPanel Orientation="Horizontal" Spacing="5" Margin="8,0,10,0" VerticalAlignment="Center"><Button x:Name="AllTargetsButton" Content="All Targets" Click="OpenAllTargets" ToolTip.Tip="Show every target together"/><Button Content="+" Click="NewTargetFromOverview" ToolTip.Tip="Add a target"/><TextBlock x:Name="TargetCount" Text="0" FontSize="10" Foreground="#747A84"/></StackPanel>
        <ComboBox Grid.Column="1" x:Name="TargetGroupFilter" Width="132" Height="26" MinHeight="26" ToolTip.Tip="Filter open tabs by group. Monitoring continues in hidden groups." AutomationProperties.Name="Visible target group"/>
        <Grid Grid.Column="2"><TextBlock x:Name="TargetFilterEmpty" Margin="8,0" Foreground="#898F9A" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <ListBox x:Name="TargetList" Background="Transparent" SelectionChanged="TargetChanged" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate><DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="6" MinWidth="155"><StackPanel.ContextMenu><ContextMenu><MenuItem Header="Assign group…" Click="OpenTargetGroup"/></ContextMenu></StackPanel.ContextMenu><TextBlock Text="●" Foreground="{Binding StatusBrush}" FontSize="8" VerticalAlignment="Center"/><TextBlock Text="{Binding Label}" MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Target}" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="{Binding StateLabel}" FontSize="9" Foreground="#898F9A" VerticalAlignment="Center"/><Button Classes="close-target" Content="×" Click="CloseTarget" ToolTip.Tip="Close target (saved target and history are kept)" AutomationProperties.Name="Close target"/></StackPanel>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox></Grid>
        <Button Grid.Column="3" Name="ScrollTargetsLeft" Content="‹" Width="24" Click="ScrollTargetTabs" Tag="Left" ToolTip.Tip="Scroll targets left"/>
        <Button Grid.Column="4" Name="ScrollTargetsRight" Content="›" Width="24" Click="ScrollTargetTabs" Tag="Right" ToolTip.Tip="Scroll targets right"/>
        <Button Grid.Column="5" Name="TargetOverflow" Content="▾" Width="26" Click="OpenTargetOverflow" ToolTip.Tip="Find an open target" AutomationProperties.Name="Find an open target"/>

      </Grid>
    </Border>
    <Border Grid.Row="2" Background="#26282D" BorderBrush="#41444A" BorderThickness="0,0,0,1" Padding="6,5">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
        <TextBox x:Name="TargetInput" Watermark="Hostname or IP address" KeyDown="TargetKeyDown" TextChanged="NewTargetTextChanged"/>
        <Button Grid.Column="1" Classes="primary" x:Name="StartButton" Content="▶" Width="42" Click="StartTrace" AutomationProperties.Name="Start monitoring"/>
        <Button Grid.Column="2" x:Name="MonitoringMenuButton" Content="▾" Width="28" ToolTip.Tip="Monitoring actions">
          <Button.Flyout><MenuFlyout>
            <MenuItem x:Name="BulkGroupActions" Header="Current Group" IsEnabled="False"/>
            <MenuItem x:Name="StartGroupAction" Header="Start / Resume Group" Tag="Group:Start" Click="BulkMonitoringAction"/>
            <MenuItem x:Name="PauseGroupAction" Header="Pause Group" Tag="Group:Pause" Click="BulkMonitoringAction"/>
            <MenuItem x:Name="CloseGroupTabsAction" Header="Close All Group Tabs…" Tag="Group:Close" Click="BulkMonitoringAction"/>
            <Separator x:Name="GroupActionsSeparator"/>
            <MenuItem Header="All Targets" IsEnabled="False"/>
            <MenuItem x:Name="StartAllAction" Header="Start / Resume All" Tag="All:Start" Click="BulkMonitoringAction"/>
            <MenuItem x:Name="PauseAllAction" Header="Pause All" Tag="All:Pause" Click="BulkMonitoringAction"/>
            <MenuItem x:Name="CloseAllTabsAction" Header="Close All Tabs…" Tag="All:Close" Click="BulkMonitoringAction"/>
            <Separator/>
            <MenuItem x:Name="SelectedTargetActions" Header="Selected Target">
              <MenuItem x:Name="StopTraceAction" Header="Stop Trace" Click="StopTrace" ToolTip.Tip="End this trace. Its tab, current statistics and saved history remain. Starting again begins a new trace."/>
              <MenuItem x:Name="RestartTraceAction" Header="Restart Trace" Click="RestartTrace" ToolTip.Tip="Start a fresh trace using the same settings. Previous history is preserved."/>
              <MenuItem x:Name="ResetStatisticsAction" Header="Reset Statistics" Click="ResetStatistics"/>
              <Separator/>
              <MenuItem x:Name="CloseTargetAction" Header="Close Target" Click="CloseSelectedTarget" ToolTip.Tip="Stop monitoring and close this tab. Its saved target and history remain."/>
            </MenuItem>
            <MenuItem x:Name="NewTargetAction" Header="New Target" Click="NewTargetFromOverview"/>
          </MenuFlyout></Button.Flyout>
        </Button>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"><TextBlock Text="Interval" VerticalAlignment="Center"/><ComboBox x:Name="IntervalInput" Width="112" SelectedIndex="2"><ComboBoxItem Content="500 ms"/><ComboBoxItem Content="1 second"/><ComboBoxItem Content="2.5 seconds"/><ComboBoxItem Content="5 seconds"/><ComboBoxItem Content="10 seconds"/></ComboBox></StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4"><TextBlock Text="Focus" VerticalAlignment="Center"/><ComboBox x:Name="FocusInput" Width="104" SelectedIndex="0" SelectionChanged="FocusChanged"><ComboBoxItem Content="Auto"/><ComboBoxItem Content="Latest sample"/><ComboBoxItem Content="Held"/></ComboBox></StackPanel>
        <Button Grid.Column="5" x:Name="ConfigureProbeButton" Content="Configure Probe" Click="OpenProbeConfiguration" MinWidth="110" ToolTip.Tip="Edit this target's probe settings"/>
        <TextBlock Grid.Column="6" x:Name="ProbeSummary" Text="ICMP" VerticalAlignment="Center" FontSize="11" Margin="6,0"/>
        <StackPanel Grid.Column="7" Spacing="2" VerticalAlignment="Center" Margin="6,0,0,0"><TextBlock x:Name="LatencyLegend" Text="100 ms   200 ms" FontSize="9" Foreground="#B9BDC3"/><Grid Width="82" Height="4" ColumnDefinitions="*,*,*"><Border Background="#528447"/><Border Grid.Column="1" Background="#B29953"/><Border Grid.Column="2" Background="#B85858"/></Grid></StackPanel>
      </Grid>
    </Border>
    <!-- Existing Settings/profile bindings share this adapter; user edits are staged in Probe Configuration. -->
    <Border IsVisible="False" Background="#22242A" BorderBrush="#373A40" BorderThickness="0,0,0,1" Padding="6,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
        <TextBox x:Name="GroupInput" Text="Default" MaxLength="80" IsVisible="False"/>
        <ComboBox x:Name="TimeoutInput" SelectedIndex="1"><ComboBoxItem Content="500 ms"/><ComboBoxItem Content="1 s timeout"/><ComboBoxItem Content="2 s timeout"/></ComboBox>
        <NumericUpDown x:Name="MaxHopsInput" Value="30" Minimum="1" Maximum="64"/>

        <TextBlock Text="Probe" VerticalAlignment="Center" Foreground="#999FA9"/>
        <ComboBox Grid.Column="1" x:Name="ProtocolInput" Width="78"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <ComboBox x:Name="UdpModeInput" Width="104" IsVisible="False" ToolTip.Tip="UDP fixed destination port or sequential destination-port range"><ComboBoxItem Content="Fixed port"/><ComboBoxItem Content="Port range"/></ComboBox>
          <NumericUpDown x:Name="PortInput" Minimum="1" Maximum="65535" Value="443" Width="66" MinWidth="66" Padding="6,0" ShowButtonSpinner="False" FormatString="0" ToolTip.Tip="TCP destination port / UDP starting destination port"/>
          <TextBlock x:Name="UdpRangeSeparator" Text="–" VerticalAlignment="Center" IsVisible="False"/>
          <NumericUpDown x:Name="UdpEndPortInput" Minimum="1" Maximum="65535" Value="33625" Width="66" MinWidth="66" Padding="6,0" ShowButtonSpinner="False" FormatString="0" IsVisible="False" ToolTip.Tip="UDP ending destination port, inclusive"/>
        </StackPanel>
        <ComboBox Grid.Column="3" x:Name="SourceInput" Width="180" ToolTip.Tip="Source interface / address"/>
        <Button Grid.Column="4" x:Name="ProbeDetailsButton" Content="UDP settings…" Click="OpenProbeDetails" ToolTip.Tip="UDP packet size, including IP and UDP headers"/>
        <ComboBox Grid.Column="6" x:Name="ProfileInput" Width="140" PlaceholderText="Probing profile" SelectionChanged="ApplyProfile"/>
        <Button Grid.Column="7" Content="Save profile" Click="SaveProfile"/>
      </Grid>
    </Border>
    <Grid Grid.Row="3" x:Name="AnalysisGrid" RowDefinitions="0.32*,6,0.68*">
      <Grid Grid.Row="0" x:Name="SingleTargetPane" RowDefinitions="*,Auto,22,22">
        <Grid ColumnDefinitions="*,285" Background="#191A1D">
          <DataGrid x:Name="HopTable" ColumnHeaderHeight="24" RowHeight="22" FontSize="11" IsReadOnly="True" AutoGenerateColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" SelectionMode="Single" SelectionChanged="HopChanged" GridLinesVisibility="None" Background="#191A1D">
            <DataGrid.Styles><Style Selector="DataGridRow"><Setter Property="ToolTip.Tip" Value="{Binding StatisticsHint}"/></Style></DataGrid.Styles>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Hop" Width="64"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><Button Classes="graph-toggle" Content="▥" Foreground="{Binding GraphBrush}" Click="ToggleHopGraph" PointerPressed="GraphIndicatorPressed" ToolTip.Tip="{Binding GraphHint}" AutomationProperties.Name="Toggle hop history graph"/><Border Width="16" Height="16" CornerRadius="8" Background="{Binding StatusBrush}" VerticalAlignment="Center"><TextBlock Text="{Binding HopLabel}" FontSize="10" Foreground="#141C15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="Count" Binding="{Binding Sent}" Width="52"/>
              <DataGridTextColumn Header="IP" Binding="{Binding IpLabel}" Width="142"/>
              <DataGridTextColumn Header="Name" Binding="{Binding NameLabel}" Width="*" MinWidth="115"/>
              <DataGridTextColumn Header="Avg" Binding="{Binding AverageLabel}" Width="48"/>
              <DataGridTextColumn Header="Min" Binding="{Binding MinimumLabel}" Width="48"/>
              <DataGridTextColumn Header="Cur" Binding="{Binding CurrentLabel}" Width="48"/>
              <DataGridTextColumn Header="Jit" Binding="{Binding JitterLabel}" Width="48"/>
              <DataGridTextColumn Header="PL%" Binding="{Binding LossLabel}" Width="46"/>
            </DataGrid.Columns>
          </DataGrid>
          <controls:HopLatencyPlot Grid.Column="1" x:Name="RoutePlot" RowHeight="22" HeaderHeight="24"/>
        </Grid>
        <Button Grid.Row="1" x:Name="UnansweredHopsButton" IsVisible="False" HorizontalAlignment="Left" Margin="6,2" Click="ToggleUnansweredHops" ToolTip.Tip="Show or collapse unanswered trailing TTL positions"/>
        <Border Grid.Row="2" Background="#202227" BorderBrush="#35383E" BorderThickness="0,1,0,0">
          <Grid ColumnDefinitions="*,285">
            <Grid ColumnDefinitions="64,52,142,*,48,48,48,48,46" Margin="0,2">
              <TextBlock Grid.Column="1" x:Name="FooterCount" Text="—" Margin="4,0" ToolTip.Tip="Eligible destination probe attempts; network failures count, local setup errors do not"/>
              <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="Destination round trip (ms)" Margin="4,0" FontSize="10" Foreground="#979CA6"/>
              <TextBlock Grid.Column="4" x:Name="FooterAverage" Text="—" Margin="4,0" ToolTip.Tip="Destination average latency"/>
              <TextBlock Grid.Column="5" x:Name="FooterMinimum" Text="—" Margin="4,0" ToolTip.Tip="Destination minimum latency"/>
              <TextBlock Grid.Column="6" x:Name="FooterCurrent" Text="—" Margin="4,0" ToolTip.Tip="Destination current latency"/>
            </Grid>
          </Grid>
        </Border>
        <Border Grid.Row="3" Background="#202227" BorderBrush="#35383E" BorderThickness="0,1,0,0" Padding="7,2">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock x:Name="LatencyValue" Text="—" IsVisible="False"/><TextBlock Text="Response loss" FontSize="10" Foreground="#979CA6"/><TextBlock x:Name="LossValue" Text="—" FontSize="11"/><TextBlock Text="Jitter" FontSize="10" Foreground="#979CA6"/><TextBlock x:Name="JitterValue" Text="—" FontSize="11"/><TextBlock Text="MOS est." FontSize="10" Foreground="#979CA6"/><TextBlock x:Name="MosValue" Text="—" FontSize="11"/><TextBlock Text="Avg 30s / 5m" FontSize="10" Foreground="#979CA6"/><TextBlock x:Name="ShortAverageValue" Text="—" FontSize="11"/><TextBlock x:Name="LongAverageValue" Text="—" FontSize="11"/></StackPanel><TextBlock Grid.Column="1" x:Name="FocusRange" Text="Focus: Auto" FontSize="10" Foreground="#A5ABB6"/></Grid>
        </Border>
      </Grid>
      <views:AllTargetsView Grid.Row="0" x:Name="AllTargetsPane" IsVisible="False"/>
      <GridSplitter Grid.Row="1" x:Name="HistoryPanelDivider" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" Background="#373A40" ToolTip.Tip="Drag to resize history · double-click to reset"/>
      <Grid Grid.Row="2" x:Name="HistoryPane" RowDefinitions="*,23">
      <ScrollViewer Grid.Row="0" x:Name="HistoryGraphsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="HistoryGraphsPanel" Spacing="0">
          <Grid x:Name="PrimaryGraphFrame" RowDefinitions="30,*">
            <Grid x:Name="PrimaryGraphHeadingRow" ColumnDefinitions="*,Auto,Auto" Background="#24262A" Margin="0,0,0,1"><TextBlock x:Name="PrimaryGraphHeader" Text="Destination history" Margin="7,1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="1" x:Name="HistoryTimeControls" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><ComboBox x:Name="HorizonInput" Width="120" SelectedIndex="2" SelectionChanged="ViewChanged"><ComboBoxItem Content="1 minute"/><ComboBoxItem Content="5 minutes"/><ComboBoxItem Content="10 minutes"/><ComboBoxItem Content="15 minutes"/><ComboBoxItem Content="1 hour"/><ComboBoxItem Content="6 hours"/><ComboBoxItem Content="24 hours"/><ComboBoxItem Content="7 days"/></ComboBox><Button x:Name="ClearSelectionButton" Content="Clear selection" IsVisible="False" Click="ClearHistorySelection"/><Button x:Name="LiveHistoryButton" Content="Live" Click="GoLive"/></StackPanel><Button Grid.Column="2" Classes="close-target" Content="×" Click="ClosePrimaryHistoryGraph" AutomationProperties.Name="Close history graph"/></Grid>
            <controls:LatencyTimeline Grid.Row="1" x:Name="Timeline"/>
          </Grid>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="1" Margin="8,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"><TextBlock Text="History" Foreground="#8C929C" FontSize="10" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="HistorySlider" Height="18" MinHeight="18" Minimum="0" Maximum="100" Value="100" ValueChanged="HistoryPositionChanged"/><TextBlock Grid.Column="2" x:Name="HistoryPosition" Text="LIVE" FontSize="9" Foreground="#91C898" VerticalAlignment="Center"/></Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="4" Background="#22242A" BorderBrush="#373A40" BorderThickness="0,1,0,0" Padding="7,2"><Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="StatusText" Text="Ready · ICMP · saved locally" Foreground="#8F95A0" FontSize="9" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button x:Name="UpdateIndicator" Classes="update-indicator" IsVisible="False" Click="ViewAvailableUpdate" AutomationProperties.Name="Review available update"/><TextBlock x:Name="VersionLabel" Text="Pngr 0.7.0" MaxWidth="200" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="9" Foreground="#737A86" VerticalAlignment="Center"/></StackPanel></Grid></Border>
  </Grid>
  </DockPanel>
</Window>
