{
  "name": "pngr-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/assets.mjs && next dev",
    "build": "node scripts/assets.mjs && next build --webpack && node scripts/export.mjs",
    "postinstall": "fumadocs-mdx",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "fumadocs-core": "16.17.3",
    "fumadocs-ui": "16.17.3",
    "fumadocs-mdx": "15.4.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^20.19.0",
    "@types/mdx": "^2.0.13",
    "@playwright/test": "^1.58.0",
    "cheerio": "^1.2.0"
  }
}
